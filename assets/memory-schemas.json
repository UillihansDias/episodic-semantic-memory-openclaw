{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional Agent Memory Logical Record (not OpenClaw Markdown validator)",
  "description": "Illustrative future-backend contract; no runtime integration. Lifecycle tracks existing records; deletion is an operation, not a stored state.",
  "oneOf": [
    {
      "$ref": "#/$defs/episodic"
    },
    {
      "$ref": "#/$defs/semantic"
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "reference",
        "observed_at"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lifecycle": {
      "enum": [
        "active",
        "disputed",
        "superseded",
        "expired",
        "invalid",
        "archived"
      ]
    },
    "evidence_status": {
      "enum": [
        "explicit",
        "verified",
        "inferred",
        "tentative",
        "disputed"
      ]
    },
    "episodic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "event",
        "event_time",
        "recorded_at",
        "context",
        "source",
        "evidence_status",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "episodic"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "event_time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "time_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "object",
          "minProperties": 1
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "evidence_status": {
          "$ref": "#/$defs/evidence_status"
        },
        "related_memories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/lifecycle"
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "subject",
        "predicate",
        "object",
        "scope",
        "knowledge_status",
        "valid_from",
        "valid_until",
        "sources",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "semantic"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "minProperties": 1
        },
        "knowledge_status": {
          "$ref": "#/$defs/evidence_status"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/lifecycle"
        }
      }
    }
  }
}
